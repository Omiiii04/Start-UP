# ============================================================
# ProjectBridge Frontend — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# --- Google OAuth 2.0 ---
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID → Web Application
# Authorized JS Origins: http://localhost:5173, https://your-app.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
