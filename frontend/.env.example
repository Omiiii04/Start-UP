# ProjectBridge Environment Variables
# Google OAuth 2.0 Client ID (Create in Google Cloud Console: Credentials -> OAuth 2.0 Client ID -> Web Application)
# Authorized Javascript Origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# Admin emails whitelist (comma-separated). Users logging in with these Google emails receive full Admin privileges.
VITE_ADMIN_EMAILS=admin@projectbridge.io,om@projectbridge.io,somnath@projectbridge.io,falguni@projectbridge.io,divya@projectbridge.io
