# ============================================================
# ProjectBridge Frontend — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# --- Google OAuth 2.0 ---
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID → Web Application
# Authorized JS Origins: http://localhost:5173, https://your-app.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Backend API URL ---
# Local development: http://localhost:3001
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:3001

# --- Admin email whitelist (UI-side gating only — backend is authoritative for actual role assignment)
# Note: This is exposed in the browser bundle and used only for UI display hints.
# The backend resolves roles from its own ADMIN_EMAILS env variable, NOT this one.
VITE_ADMIN_EMAILS=om@projectbridge.io,somnath@projectbridge.io,falguni@projectbridge.io,divya@projectbridge.io

# --- Demo Mode (set to 'true' to show sandbox/demo login accounts in the auth modal)
# IMPORTANT: Set this to 'false' or leave empty in production.
# When false, the demo account quick-switch buttons are hidden.
VITE_DEMO_MODE=true
