# =============================================================================
# ProjectBridge Backend — Environment Variables
# Copy this file to .env and fill in all values before running the server.
# NEVER commit .env to version control.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=3001

# --- Database (PostgreSQL) ---
# Render PostgreSQL: get from Render Dashboard > PostgreSQL > Connection Details
# Supabase: Settings > Database > Connection String (URI)
DATABASE_URL=postgresql://user:password@host:5432/projectbridge

# --- JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change_me_to_64_byte_random_hex_string
JWT_REFRESH_SECRET=change_me_to_another_64_byte_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth 2.0 ---
# Same Client ID as frontend — create at: console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Admin Emails (server-side authoritative list — not exposed to client)
ADMIN_EMAILS=om@projectbridge.io,somnath@projectbridge.io,falguni@projectbridge.io,divya@projectbridge.io

# --- Cloudinary (File Uploads — max 100MB)
# Get from: cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- SendGrid (Email Notifications)
# Get API key from: app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@projectbridge.io
SENDGRID_FROM_NAME=ProjectBridge

# --- WhatsApp Business API (Meta Cloud API)
# Setup at: developers.facebook.com — Create App > WhatsApp > Get Started
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# --- CORS (allowed origins, comma-separated)
CORS_ORIGIN=http://localhost:5173,https://projectbridge.vercel.app
