# =============================================================================
# ProjectBridge Backend — Environment Variables
# Copy this file to .env and fill in all values before running the server.
# NEVER commit .env to version control.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=3001

# --- Database (PostgreSQL) ---
# Supabase: Settings > Database > Connection String (URI)
# Render:   Dashboard > PostgreSQL > Connection Details
DATABASE_URL=postgresql://user:password@host:5432/projectbridge

# --- JWT Secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_64_byte_random_hex_string
JWT_REFRESH_SECRET=change_me_to_another_64_byte_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth 2.0 ---
# Create at: console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0 Client ID
# Required — the backend verifies Google ID tokens against this client ID.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Admin emails (comma-separated, server-authoritative role assignment) ---
ADMIN_EMAILS=omapar00@gmail.com

# --- Cloudinary (File Uploads) ---
# Get from: cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Telegram Bot (primary notification/chat channel) ---
# Create a bot at: https://t.me/BotFather → /newbot
# See TELEGRAM_SETUP.md for full instructions.
#
# SECURITY: TELEGRAM_BOT_TOKEN must NEVER be exposed to the frontend.
# It is used only on the backend. The bot USERNAME is public and safe to display.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=start_up
TELEGRAM_ADMIN_CHAT_ID=your_admin_telegram_chat_id
# A random secret for validating incoming webhook requests from Telegram.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=change_me_to_random_hex_string

# --- CORS (allowed frontend origins, comma-separated) ---
# Development: http://localhost:5173
# Production: https://your-deployed-frontend-url.com
CORS_ORIGIN=http://localhost:5173
